# Repositório da imagem no registry. Por omissão usa as imagens públicas da formação.
IMAGE_REPO=ghcr.io/skullclamp/symfony-demo

# Versão/tag da aplicação a executar. O laboratório altera este valor entre 1.0.0,
# 1.1.0 e 1.2.0-rc1 para demonstrar update, falha e rollback.
APP_VERSION=1.0.0

# Porta publicada na VM. O container continua a escutar na porta 80.
APP_PORT=8080

# Ambiente Symfony em runtime.
APP_ENV=prod

# Valor apenas didático. Este ficheiro facilita configuração, mas NÃO é um secret manager.
APP_SECRET=lab-only-session3-change-me

# Configuração da base de dados PostgreSQL usada no laboratório.
POSTGRES_DB=symfony
POSTGRES_USER=symfony
POSTGRES_PASSWORD=lab-symfony

# String de ligação usada pela aplicação. O hostname db é o nome do serviço Compose.
DATABASE_URL=postgresql://symfony:lab-symfony@db:5432/symfony?serverVersion=16&charset=utf8
