# Imagem mínima usada apenas para demonstrar uma má prática.
FROM alpine:3.20

# MAU PADRÃO: recebe um valor potencialmente sensível como argumento de build.
# ARG existe durante o build e não deve ser tratado como mecanismo seguro de secrets.
ARG API_TOKEN

# MAU PADRÃO: copia o valor para ENV, fazendo-o persistir na configuração da imagem
# e ficar disponível aos containers criados a partir dela.
ENV API_TOKEN=${API_TOKEN}

# Cria apenas uma mensagem pedagógica. O objetivo deste ficheiro não é usar o token,
# mas permitir observar com docker history/inspect porque ARG/ENV são inadequados.
RUN echo "Exemplo incorreto: não persistir secrets em ARG/ENV" >/message.txt

# Mostra a mensagem quando o container é executado.
CMD ["cat", "/message.txt"]
