# Ativa a sintaxe moderna do Dockerfile necessária para --mount=type=secret.
# syntax=docker/dockerfile:1

# Imagem mínima usada apenas para demonstrar um secret de build.
FROM alpine:3.20

# O secret API_TOKEN é disponibilizado TEMPORARIAMENTE apenas nesta instrução RUN.
# A opção env=API_TOKEN pede ao BuildKit para expor o secret diretamente como
# variável de ambiente desta instrução, em vez de criar um ficheiro permanente.
# O valor não é persistido na imagem nem fica disponível no container final.
RUN --mount=type=secret,id=API_TOKEN,env=API_TOKEN \
    test -n "$API_TOKEN" \
    && echo "Secret disponível apenas durante esta instrução RUN" > /message.txt

# Quando o container arranca, apresenta apenas a mensagem criada no build.
# API_TOKEN já não está disponível.
CMD ["cat", "/message.txt"]
