# Ativa a sintaxe moderna do Dockerfile necessária para --mount=type=secret.
# syntax=docker/dockerfile:1

# Imagem mínima usada apenas para demonstrar um secret de build.
FROM alpine:3.20

# O secret identificado por demo_secret é montado temporariamente em
# /run/secrets/demo_secret apenas durante esta instrução RUN.
# test -s confirma que o ficheiro existe e não está vazio.
# O conteúdo do secret não é copiado para a imagem final.
RUN --mount=type=secret,id=demo_secret \
    test -s /run/secrets/demo_secret \
    && echo "Secret disponível apenas durante esta instrução RUN" >/message.txt

# Quando o container arranca, apresenta apenas a mensagem criada no build.
# O secret utilizado anteriormente já não está disponível.
CMD ["cat", "/message.txt"]
