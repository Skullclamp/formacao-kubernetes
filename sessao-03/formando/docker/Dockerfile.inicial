# Imagem base: PHP 8.4 com Apache sobre Debian Bookworm.
# Esta primeira imagem continua deliberadamente simples/single-stage para permitir
# comparar mais tarde com o Dockerfile multi-stage otimizado.
FROM php:8.4-apache-bookworm

# Configuração do ambiente durante o build e runtime:
# - permite ao Composer correr como root durante o build;
# - usa APP_ENV=prod para que o comportamento observado seja próximo do deployment;
# - desativa o debug e evita a Web Debug Toolbar na imagem usada no laboratório.
ENV COMPOSER_ALLOW_SUPERUSER=1 \
    APP_ENV=prod \
    APP_DEBUG=0

# Instala ferramentas e bibliotecas necessárias e ativa extensões PHP/Apache:
# - apt-get update atualiza o índice de pacotes;
# - --no-install-recommends evita dependências opcionais;
# - docker-php-ext-install compila/ativa extensões PHP;
# - -j"$(nproc)" usa os CPUs disponíveis para acelerar a compilação;
# - a2enmod rewrite ativa mod_rewrite, necessário ao routing da aplicação;
# - configura ServerName para evitar avisos do Apache;
# - remove /var/lib/apt/lists para não deixar cache apt na imagem.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       curl git unzip libicu-dev libpq-dev libsqlite3-dev \
    && docker-php-ext-install -j"$(nproc)" intl opcache pdo_pgsql pdo_sqlite \
    && a2enmod rewrite \
    && printf 'ServerName localhost\n' > /etc/apache2/conf-available/servername.conf \
    && a2enconf servername \
    && rm -rf /var/lib/apt/lists/*

# Copia apenas o binário Composer a partir da imagem oficial composer:2.
# Evita instalar o Composer manualmente e reutiliza um artefacto conhecido.
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

# Define a diretoria de trabalho da aplicação e copia o código Symfony.
WORKDIR /var/www/html
COPY app/ ./

# Substitui o VirtualHost Apache pela configuração preparada para Symfony,
# cujo DocumentRoot aponta para /var/www/html/public.
COPY formando/docker/000-default.conf /etc/apache2/sites-available/000-default.conf

# Instala as dependências PHP e executa os auto-scripts definidos em composer.json.
# Na Symfony Demo esses scripts incluem preparação de importmap/assets e Sass.
# Em seguida, executa explicitamente a sequência de deployment recomendada para
# AssetMapper: primeiro compila Sass e depois compila os assets versionados para
# public/assets, para que Apache possa servi-los diretamente em APP_ENV=prod.
RUN composer install --no-interaction --prefer-dist --optimize-autoloader \
    && php bin/console sass:build --no-interaction \
    && php bin/console asset-map:compile --no-interaction \
    && test -d public/assets \
    && test -f public/assets/manifest.json \
    && mkdir -p var/cache var/log \
    && chown -R www-data:www-data var

# Documenta que a aplicação espera receber tráfego HTTP na porta 80.
# EXPOSE não publica a porta no host; essa publicação é feita com -p ou Compose.
EXPOSE 80

# Verifica periodicamente a saúde da aplicação através de /health:
# - interval=10s: frequência entre testes;
# - timeout=3s: tempo máximo por teste;
# - start-period=20s: tolerância durante o arranque;
# - retries=5: falhas consecutivas até marcar unhealthy;
# - curl -f falha em HTTP 4xx/5xx, -s é silencioso e -S mantém erros visíveis.
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=5 \
    CMD curl -fsS http://localhost/health >/dev/null || exit 1

# Processo principal do container. O script da imagem oficial mantém o Apache
# em foreground para que o ciclo de vida do container acompanhe o servidor web.
CMD ["apache2-foreground"]
