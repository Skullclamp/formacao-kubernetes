# Copiar para .env antes do laboratório:
# cp .env.example .env

# Imagem previamente construída e publicada pelo formador no GitHub Container Registry.
SYMFONY_IMAGE=ghcr.io/skullclamp/symfony-demo:1.0

APP_PORT=8080
APP_ENV=dev

POSTGRES_DB=symfony
POSTGRES_USER=symfony
POSTGRES_PASSWORD=lab-symfony

DATABASE_URL=postgresql://symfony:lab-symfony@db:5432/symfony?serverVersion=16&charset=utf8
